# Local settings contain subscription links and the feed token
/nodesieve_config.json

# Written by the checker; these hold proxy credentials
/steer-output/
/crashed_nodes.txt
/sub_cache/
/feed/
# Written by tools/core_bench.py: node names and server addresses
/core-bench/

# Written by earlier versions, which a checkout may still hold: settings, router scripts
# and AmneziaWG profiles, all with credentials
/proxy_sites_config.json
/apply_to_router.sh
/forkozz-output/
/*.conf

# Core binaries, downloaded on first run
/xray
/xray.exe
/mihomo
/mihomo.exe

# Xray binary
/xray
/xray.exe

# Local scratch: sample nodes and pre-refactoring backups
/node.txt
/test_node.yaml
/test_config.yaml
/.pre-*-backup-*.tar.gz

# Agent workspaces and request logs; only the shared guidelines are tracked
/.agents/*
!/.agents/AGENTS.md
/ORIGINAL_REQUEST.md

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
